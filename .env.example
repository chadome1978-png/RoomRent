# Copy this file to the RoomRent project root as .env, then replace both placeholders.
# Source: Supabase Dashboard > Project Settings > API
# VITE_* values are embedded in browser JavaScript: use only the publishable key
# (sb_publishable_...) or legacy anon key with database RLS enabled.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# NEVER add SUPABASE_SERVICE_ROLE_KEY or any secret key to this browser app.
